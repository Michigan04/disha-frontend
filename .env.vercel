# ── Vercel + Neon environment variables (TEMPLATE: no real values here) ──────
# Set each of these in Vercel → Project → Settings → Environment Variables.
# Never commit real credentials: this repository is public.
#
# Only DATABASE_URL is required, and not even that when Vercel's Neon integration
# is connected to the project (its POSTGRES_URL is used). On Vercel the backend
# defaults USE_NULL_POOL=true, AUTO_MIGRATE=false and AUTO_SEED=false.

# Neon connection string. Use the POOLED one (host contains "-pooler"), exactly
# as Neon shows it; postgresql:// is converted to psycopg 3 automatically.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Required for serverless: no SQLAlchemy connection pool (Neon's pooler does it).
USE_NULL_POOL=true

# Optional: derived from DATABASE_URL when unset. Set it so sign-ins survive a
# change of database password. Long random secret for signing sign-in tokens:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=720

# The frontend and API share one Vercel domain, so CORS is not needed there.
# Only list other origins that call this API (for example local dev).
CORS_ORIGINS=http://localhost:5173

# Set the database up ONCE from your machine instead (README: "Deploy on Vercel"):
#   cd backend && DATABASE_URL="<neon url>" python -m app.bootstrap
# Keep these false so cold starts never run migrations or seeding.
AUTO_MIGRATE=false
AUTO_SEED=false

# Demo sign-in page (true shows click-to-fill demo accounts).
SHOW_DEMO_ACCOUNTS=true
DEMO_PASSWORD=disha123

# false = plain-text passwords (team's demo choice). Use true for real users.
HASH_PASSWORDS=false

# Leave OLLAMA_MODEL empty: Vercel cannot reach a local Ollama, so the
# built-in replies answer. Point OLLAMA_URL at a hosted Ollama to use a model.
OLLAMA_URL=
OLLAMA_MODEL=
