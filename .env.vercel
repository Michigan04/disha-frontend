# ── Vercel + Neon deployment environment variables ────────────────────────────
# Set each of these in your Vercel project → Settings → Environment Variables.
# DO NOT commit real credentials to git.

# Neon database connection string.
# Use the *pooled* URL (port 5432) so Neon's pgBouncer handles connection
# pooling. With USE_NULL_POOL=true, SQLAlchemy itself will not pool.
# Format: postgresql+psycopg://<user>:<pass>@<host>/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://neondb_owner:CHANGE_ME@ep-aged-heart-b70sf2ba.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require

# Must be true for Neon serverless — disables SQLAlchemy's own connection pool.
USE_NULL_POOL=true

# A long random secret for JWT signing — generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

JWT_EXPIRE_MINUTES=720

# Your Vercel frontend URL (no trailing slash).
# Example: https://disha-team026.vercel.app
# Also add http://localhost:5173 for local dev against the deployed backend.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Run alembic migrations and seed the DB on first cold start.
AUTO_MIGRATE=true
AUTO_SEED=true
SEED_DEMO_DATA=true

DEFAULT_ADMIN_EMAIL=admin@disha.demo
DEFAULT_ADMIN_PASSWORD=disha123
DEFAULT_ADMIN_NAME=Suresh Pillai
DEMO_PASSWORD=disha123
SHOW_DEMO_ACCOUNTS=true

# No encryption for now (team decision).
HASH_PASSWORDS=false

# Leave blank to use the built-in rule-based chat replies.
OLLAMA_URL=
OLLAMA_MODEL=
