# ── Local development ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is never committed to git.

# Postgres connection string.
# Local:  postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/disha
# Neon:   postgresql+psycopg://user:pass@ep-xxx-yyy.us-east-2.aws.neon.tech/disha?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/disha

# Set to true when deploying to Neon / Vercel so SQLAlchemy uses NullPool
# (Neon's pooler handles connection pooling; SQLAlchemy's pool wastes slots).
USE_NULL_POOL=false

# A long random string; used to sign JWT tokens.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Comma-separated origins the browser is allowed to call the API from.
# Add your Vercel frontend URL here when deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# On startup: apply Alembic migrations, then seed an empty database.
AUTO_MIGRATE=true
AUTO_SEED=true

# Seed the 60-student demo cohort (false = only admin + reference data).
SEED_DEMO_DATA=true

# Default admin account (created when the DB is first seeded).
DEFAULT_ADMIN_EMAIL=admin@disha.demo
DEFAULT_ADMIN_PASSWORD=disha123
DEFAULT_ADMIN_NAME=Suresh Pillai

# Password used for all demo accounts.
DEMO_PASSWORD=disha123

# Show click-to-fill demo accounts on the sign-in page.
SHOW_DEMO_ACCOUNTS=true

# false = passwords stored as plain text (current demo choice).
# true  = PBKDF2-SHA256 hashes; plain passwords auto-upgrade on next login.
HASH_PASSWORDS=false

# Chatbot: leave OLLAMA_MODEL empty to use the built-in rule-based replies.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
