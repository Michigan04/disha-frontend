# Copy to .env and fill in. .env is ignored by git.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/disha
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# On startup: apply migrations, and seed an empty database
AUTO_MIGRATE=true
AUTO_SEED=true
# Seed the 60-student demo cohort (false = only the default admin and reference data)
SEED_DEMO_DATA=true
DEFAULT_ADMIN_EMAIL=admin@disha.demo
DEFAULT_ADMIN_PASSWORD=disha123
DEFAULT_ADMIN_NAME=Suresh Pillai
DEMO_PASSWORD=disha123
# Show the click-to-fill demo accounts on the sign-in page
SHOW_DEMO_ACCOUNTS=true
# false = passwords are stored as plain text (current choice). true = PBKDF2 hashes.
HASH_PASSWORDS=false
# Chatbot: leave OLLAMA_MODEL empty to use the built-in rule-based replies
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
